# ============================================================
#  EM-Lumen — configuration
#  Copy to ".env" and fill in. Never commit the real .env file.
# ============================================================

# The fixed public address of the system (must be HTTPS in production
# so the player can work offline — browsers only allow Service Workers on HTTPS).
BASE_URL=https://lumen.example.com

# Port the Node server listens on (behind IIS / Caddy / nginx reverse proxy).
PORT=8080
HOST=0.0.0.0

# Set to 1 when running behind a reverse proxy (trust X-Forwarded-* headers).
TRUST_PROXY=1

# Where the database, media and backups are stored.
DATA_DIR=./data

# Long random string. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Session length in hours.
SESSION_HOURS=12

# ---------- SSO: Microsoft Entra ID (Azure AD) ----------
# Issuer for a single tenant: https://login.microsoftonline.com/<TENANT_ID>/v2.0
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPES=openid profile email
# Button label on the login page.
OIDC_DISPLAY_NAME=Microsoft (Eitan Medical)

# Optional: only these e-mail domains may log in (comma separated).
ALLOWED_EMAIL_DOMAINS=eitanmedical.com

# These users always get the "admin" role (comma separated e-mails).
ADMIN_EMAILS=

# Optional: map Entra "App roles" (claim "roles") to system roles.
# If a user has one of these app roles it overrides the stored role.
OIDC_ROLE_ADMIN=Lumen.Admin
OIDC_ROLE_EDITOR=Lumen.Editor
OIDC_ROLE_VIEWER=Lumen.Viewer

# What happens when an unknown SSO user logs in: "viewer" | "editor" | "deny"
NEW_USER_ROLE=viewer

# ---------- Break-glass local admin ----------
# Leave empty to disable. Useful for first setup or when SSO is unavailable.
LOCAL_ADMIN_USER=admin
LOCAL_ADMIN_PASSWORD=

# ---------- Limits ----------
MAX_UPLOAD_MB=1024
# Keep this many daily database backups.
BACKUP_KEEP=30

# ============================================================
#  Vercel (cloud) — set these in Vercel → Project → Settings → Environment Variables.
#  On Vercel the system automatically uses Postgres + Vercel Blob.
# ============================================================
# Added automatically when you connect a Neon database from the Vercel Marketplace:
# DATABASE_URL=postgres://...
# Added when you connect a PUBLIC Blob store and tick "Add a read-write token env var"
# (required for direct browser uploads of large videos):
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...
# Any long random string; Vercel Cron sends it to /api/cron/housekeeping:
# CRON_SECRET=
